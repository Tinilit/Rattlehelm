; Engine configuration file.
config_version=5

[application]

config/name="Rattlehelm"
run/main_scene="res://game/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://ui/crest.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.035, 0.044, 0.059, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[internationalization]

locale/fallback="en"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
2d/run_on_separate_thread=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.044, 0.059, 1)

